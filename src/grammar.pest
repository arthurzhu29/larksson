WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

file = _{ SOI ~ statement* ~ EOI }

statement = {
    set_statement
    | print_statement
}

set_statement = {
    value ~ "=" ~ value
}

print_statement = {
    "print" ~ value
}

deref = {
    "(" ~ value ~ ")"
}

value = {
    number
    | list
    | deref
}

list = {
    "{" ~ (list_item ~ ("," ~ list_item)* ~ ","?)?  ~ "}"
}

list_item = {
    value ~ ":" ~ value
}

number = @{
    ASCII_DIGIT+
}